PORT=4000
HOST=0.0.0.0
# Local: mongodb://127.0.0.1:27017/gigbudget
# Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/gigbudget?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gigbudget
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=*
EMAIL_DELIVERY_MODE=dev_log
APP_PUBLIC_NAME=GigBudget
NODE_ENV=development
