{
  "info": {
    "name": "GigBudget API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Variable-based tokens/IDs. No real production credentials."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "expenseClientId", "value": "exp-demo-1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "if (j.data) {",
              "  pm.collectionVariables.set('accessToken', j.data.accessToken);",
              "  pm.collectionVariables.set('refreshToken', j.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"Tester\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create Expense",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{expenseClientId}}\",\n  \"amountCents\": 180000,\n  \"occurredAt\": \"2026-10-03T10:00:00.000Z\",\n  \"categoryName\": \"Fuel\",\n  \"note\": \"demo\",\n  \"idempotencyKey\": \"{{expenseClientId}}\"\n}"
        },
        "url": "{{baseUrl}}/expenses"
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/dashboard"
      }
    },
    {
      "name": "Sync Push",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactions\": []\n}"
        },
        "url": "{{baseUrl}}/sync/push"
      }
    },
    {
      "name": "Negative - missing auth",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/expenses"
      }
    }
  ]
}
